/data/v5/categories/*
  Cache-Control: public, max-age=3600

/data/v5/metadata/*
  Cache-Control: public, max-age=3600

/data/v5/bitmaps/*
  Cache-Control: public, max-age=3600

/data/v5/propositions.json
  Cache-Control: public, max-age=3600

/data/v5/manifest.json
